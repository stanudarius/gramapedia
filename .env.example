# Gramapedia Environment Variables

# The canonical production site URL (without trailing slash)
NEXT_PUBLIC_SITE_URL=https://gramapedia.ro

# Google Analytics 4 Measurement ID (optional, e.g. G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Cloudflare Web Analytics Beacon Token (optional, 32-character token)
# NEXT_PUBLIC_CF_BEACON_TOKEN=your_cloudflare_beacon_token_here
